        {
          "name": "Add todo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "description": "save(): SELECT then INSERT (manual id)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{todoId}},\n  \"title\": \"{{title}}\",\n  \"completed\": {{completed}},\n  \"priority\": {{priority}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Update todo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "description": "save(): SELECT then UPDATE, same method as POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{todoId}},\n  \"title\": \"{{title}}\",\n  \"completed\": {{completed}},\n  \"priority\": {{priority}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "description": "deleteById()"
          },
          "response": []
        }
      ]
