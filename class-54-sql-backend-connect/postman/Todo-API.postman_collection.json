    {
      "name": "2. @Query (native MySQL)",
      "item": [
        {
          "name": "Pending todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "pending"
              ]
            },
            "description": "SELECT * FROM todos WHERE completed = false"
          },
          "response": []
        },
        {
          "name": "High priority todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/high-priority?priority={{priority}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "high-priority"
              ],
              "query": [
                {
                  "key": "priority",
                  "value": "{{priority}}"
                }
              ]
            },
            "description": "SELECT * FROM todos WHERE priority >= :priority ORDER BY priority DESC"
          },
          "response": []
        },
        {
          "name": "Mark completed",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}",
                "complete"
              ]
            },
            "description": "@Modifying UPDATE, returns rows affected (0 if id not found)"
          },
          "response": []
        }
      ]
    },
